<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title><%= product.name %> | Task 9</title>
  <style>
    body { font-family: 'Segoe UI', sans-serif; background: #f5f3ff; padding: 32px 16px; }
    .box { max-width: 560px; margin: 0 auto; background: #fff; padding: 28px; border-radius: 12px; }
    .btn { background: #7c3aed; color: #fff; padding: 8px 14px; border-radius: 6px; text-decoration: none; font-weight: 600; }
  </style>
</head>
<body>
  <div class="box">
    <h1><%= product.name %></h1>
    <p style="font-size:1.2rem; color:#059669; font-weight:700;">₹<%= product.price %></p>
    <p style="line-height:1.6;"><%= product.description %></p>
    <div style="margin-top:20px;">
      <a class="btn" href="/products/<%= product.id %>/edit">Edit</a>
      <a href="/products" style="margin-left:12px;">Back to All Products</a>
    </div>
  </div>
</body>
</html>
