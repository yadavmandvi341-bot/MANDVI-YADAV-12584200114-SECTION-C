<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Products | Task 9 RESTful CRUD</title>
  <style>
    body { font-family: 'Segoe UI', sans-serif; background: #f5f3ff; color: #1e1b4b; margin: 0; padding: 32px 16px; }
    .wrap { max-width: 900px; margin: 0 auto; background: #fff; padding: 28px; border-radius: 14px; box-shadow: 0 8px 24px rgba(0,0,0,0.06); }
    .top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .btn { background: #7c3aed; color: #fff; padding: 8px 14px; border-radius: 6px; text-decoration: none; font-weight: 600; border: none; cursor: pointer; }
    .btn-danger { background: #dc2626; }
    .btn-secondary { background: #475569; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 16px; }
    .card { border: 1px solid #ede9fe; border-radius: 10px; padding: 16px; background: #faf5ff; }
    .price { color: #059669; font-weight: 700; margin: 6px 0; }
    .actions { display: flex; gap: 8px; margin-top: 12px; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="top">
      <div>
        <h1 style="margin:0;">Products (RESTful CRUD)</h1>
        <small style="color:#64748b;">Mandvi Yadav — Full Stack Lab Task 9</small>
      </div>
      <a class="btn" href="/products/new">+ Add Product</a>
    </div>
    <div class="grid">
      <% products.forEach(p => { %>
        <div class="card">
          <h3 style="margin:0;"><%= p.name %></h3>
          <div class="price">₹<%= p.price %></div>
          <p style="font-size:0.9rem; color:#475569;"><%= p.description %></p>
          <div class="actions">
            <a class="btn btn-secondary" href="/products/<%= p.id %>">View</a>
            <a class="btn" href="/products/<%= p.id %>/edit">Edit</a>
            <form action="/products/<%= p.id %>?_method=DELETE" method="POST" style="display:inline;">
              <button class="btn btn-danger" type="submit">Delete</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>
