<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>New Product | Task 11</title>
  <style>
    body { font-family: 'Segoe UI', sans-serif; background: #f5f3ff; padding: 32px 16px; }
    .box { max-width: 500px; margin: 0 auto; background: #fff; padding: 28px; border-radius: 12px; }
    input, textarea { width: 100%; padding: 9px; margin: 6px 0 14px; border: 1px solid #ddd6fe; border-radius: 6px; box-sizing: border-box; }
    button { background: #7c3aed; color: #fff; border: none; padding: 10px 18px; border-radius: 6px; font-weight: 600; cursor: pointer; }
  </style>
</head>
<body>
  <div class="box">
    <h1>Add Product</h1>
    <form action="/products" method="POST">
      <label>Name</label><input type="text" name="name" required />
      <label>Category</label><input type="text" name="category" value="Electronics" required />
      <label>Price (₹)</label><input type="number" name="price" min="0" step="0.01" required />
      <label>Description</label><textarea name="description" rows="4" required></textarea>
      <button type="submit">Save Product</button>
      <a href="/products" style="margin-left:12px;">Cancel</a>
    </form>
  </div>
</body>
</html>
